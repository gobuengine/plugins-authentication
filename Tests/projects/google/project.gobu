config_version=5

[application]

config/name="login_proj"
run/main_scene="res://login.scene"
config/is_2d_project=true
game_mode/player="res://hero.prefab"
game_mode/rules="res://reglas.prefab"

[online]
session/server_level="res://main.scene"
login/check=1

[authentication]

custom/keys_url="http://127.0.0.1:18765/oauth2/v3/certs"
custom/audience="juego-de-prueba.apps.googleusercontent.com"
itch/desktop/client_id="itch-de-prueba"
itch/desktop/redirect_uri="http://127.0.0.1:43219/"

[plugins]

enabled=PackedStringArray("authentication")
