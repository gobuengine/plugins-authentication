config_version=5

[application]

config/name="login_proj"
run/main_scene="res://login.scene"
config/is_2d_project=true
game_mode/player="res://hero.prefab"
game_mode/rules="res://reglas.prefab"

[online]
session/server_level="res://main.scene"
login/check=1

[authentication]

supabase/url="http://127.0.0.1:18765"
supabase/anon_key="anon-key"
supabase/port=0

[plugins]

enabled=PackedStringArray("authentication")
